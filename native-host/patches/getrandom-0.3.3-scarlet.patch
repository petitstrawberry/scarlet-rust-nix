+//! Scarlet's native GetRandom syscall, requiring a registered entropy source.
+use crate::{Error, MaybeUninit};
+
+pub use crate::util::{inner_u32, inner_u64};
+
+#[inline]
+pub fn fill_inner(dest: &mut [MaybeUninit<u8>]) -> Result<(), Error> {
+    fill_using(dest, getrandom_syscall)
+}
+
+fn fill_using(
+    mut dest: &mut [MaybeUninit<u8>],
+    mut request: impl FnMut(&mut [MaybeUninit<u8>]) -> usize,
+) -> Result<(), Error> {
+    while !dest.is_empty() {
+        let written = request(dest);
+        // Native syscalls return usize::MAX rather than a POSIX errno. In
+        // particular there is no EINTR value to retry. Failure can leave an
+        // initialized prefix, but must never be reported as successful entropy.
+        if written == usize::MAX {
+            return Err(Error::UNSUPPORTED);
+        }
+        if written == 0 || written > dest.len() {
+            return Err(Error::UNEXPECTED);
+        }
+        dest = &mut dest[written..];
+    }
+    Ok(())
+}
+
+fn getrandom_syscall(dest: &mut [MaybeUninit<u8>]) -> usize {
+    const GET_RANDOM: usize = 22;
+    // With flags=0 the kernel may use a non-cryptographic emergency fallback.
+    // getrandom must instead fail if the platform has no real entropy source.
+    const REQUIRE_ENTROPY: usize = 1;
+    let result;
+    // SAFETY: dest is a live, writable allocation for dest.len() bytes. The
+    // native syscall writes initialized bytes and returns the written length
+    // or usize::MAX. Do not use nomem/readonly: the syscall writes through x0/a0.
+    unsafe {
+        #[cfg(target_arch = "aarch64")]
+        core::arch::asm!(
+            "svc #0",
+            in("x8") GET_RANDOM,
+            inlateout("x0") dest.as_mut_ptr() => result,
+            in("x1") dest.len(),
+            in("x2") REQUIRE_ENTROPY,
+            clobber_abi("C"),
+            options(nostack),
+        );
+        #[cfg(any(target_arch = "riscv32", target_arch = "riscv64"))]
+        core::arch::asm!(
+            "ecall",
+            in("a7") GET_RANDOM,
+            inlateout("a0") dest.as_mut_ptr() => result,
+            in("a1") dest.len(),
+            in("a2") REQUIRE_ENTROPY,
+            clobber_abi("C"),
+            options(nostack),
+        );
+        #[cfg(not(any(
+            target_arch = "aarch64",
+            target_arch = "riscv32",
+            target_arch = "riscv64"
+        )))]
+        compile_error!("Scarlet getrandom supports AArch64 and RISC-V targets only");
+    }
+    result
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn retries_partial_reads_without_overwriting_initialized_prefix() {
+        let mut dest = [MaybeUninit::uninit(); 7];
+        let mut next = 0;
+        fill_using(&mut dest, |remaining| {
+            let count = remaining.len().min(3);
+            for byte in &mut remaining[..count] {
+                byte.write(next);
+                next += 1;
+            }
+            count
+        })
+        .unwrap();
+        // SAFETY: Every byte was initialized by the successful fill above.
+        assert_eq!(dest.map(|byte| unsafe { byte.assume_init() }), [0, 1, 2, 3, 4, 5, 6]);
+    }
+
+    #[test]
+    fn empty_buffer_never_calls_kernel() {
+        assert_eq!(fill_using(&mut [], |_| panic!("empty syscall")), Ok(()));
+    }
+
+    #[test]
+    fn no_entropy_is_an_error_even_after_partial_progress() {
+        let mut dest = [MaybeUninit::uninit(); 2];
+        let mut calls = 0;
+        assert_eq!(
+            fill_using(&mut dest, |remaining| {
+                calls += 1;
+                if calls == 1 {
+                    remaining[0].write(42);
+                    1
+                } else {
+                    usize::MAX
+                }
+            }),
+            Err(Error::UNSUPPORTED)
+        );
+        assert_eq!(calls, 2);
+    }
+
+    #[test]
+    fn zero_and_oversized_results_are_rejected() {
+        let mut dest = [MaybeUninit::uninit(); 2];
+        assert_eq!(fill_using(&mut dest, |_| 0), Err(Error::UNEXPECTED));
+        assert_eq!(fill_using(&mut dest, |_| 3), Err(Error::UNEXPECTED));
+    }
+}
