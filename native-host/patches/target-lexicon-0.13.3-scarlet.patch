     #[test]
+    fn scarlet_elf_abi() {
+        use alloc::string::ToString;
+
+        for name in &[
+            "aarch64-unknown-scarlet",
+            "riscv64-unknown-scarlet",
+            "riscv64gc-unknown-scarlet",
+            "riscv64a23-unknown-scarlet",
+        ] {
+            let triple = Triple::from_str(name).unwrap();
+            assert_eq!(triple.operating_system, OperatingSystem::Scarlet);
+            assert_eq!(triple.binary_format, BinaryFormat::Elf);
+            assert_eq!(triple.default_calling_convention(), Ok(CallingConvention::SystemV));
+            assert_eq!(triple.pointer_width(), Ok(PointerWidth::U64));
+            assert_eq!(triple.endianness(), Ok(Endianness::Little));
+            assert_eq!(triple.data_model(), Ok(CDataModel::LP64));
+            assert_eq!(triple.to_string(), *name);
+        }
+        let triple = Triple::from_str("riscv32gc-unknown-scarlet").unwrap();
+        assert_eq!(triple.default_calling_convention(), Ok(CallingConvention::SystemV));
+        assert_eq!(triple.binary_format, BinaryFormat::Elf);
+        assert_eq!(triple.pointer_width(), Ok(PointerWidth::U32));
+        assert_eq!(triple.data_model(), Ok(CDataModel::ILP32));
+    }
