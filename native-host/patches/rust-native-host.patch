 #[inline]
 fn arch_tls_pointer() -> usize {
     let tpidr_el0: usize;
     // SAFETY: reading the userspace TLS register has no side effects.
     unsafe {
         core::arch::asm!(
             "mrs {}, tpidr_el0",
             out(reg) tpidr_el0,
-            options(nostack, pure, readonly)
+            options(nostack, readonly)
         );
     }
     tpidr_el0
 }

 #[cfg(any(target_arch = "riscv32", target_arch = "riscv64"))]
 #[inline]
 fn arch_tls_pointer() -> usize {
     let tp;
     // SAFETY: reading the userspace TLS register has no side effects.
     unsafe {
         core::arch::asm!(
             "mv {}, tp",
             out(reg) tp,
-            options(nostack, pure, readonly)
+            options(nostack, readonly)
         );
     }
     tp
 }
